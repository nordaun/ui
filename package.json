{
  "name": "ui",
  "version": "2.0.0",
  "description": "A collection of beatifully designed components that extend the boundaries of shadcn while staying consistent, modular and of course clean.",
  "homepage": "https://ui.nordaun.com",
  "author": "vorhdam <https://github.com/vorhdam>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nordaun/ui.git"
  },
  "keywords": [
    "shadcn",
    "registry",
    "react",
    "ui",
    "base"
  ],
  "private": true,
  "scripts": {
    "build": "npx turbo run build",
    "dev": "bun --bun turbo run dev",
    "start": "bun --bun turbo run start",
    "lint": "bun --bun turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun --bun turbo run check-types",
    "registry:build": "bun --bun turbo run registry:build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.6",
    "tsup": "^9.0.0",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
